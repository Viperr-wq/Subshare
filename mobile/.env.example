# Адрес сервера SubShare для приложения.
# Без файла .env приложение работает с сервером на Render (https://subshare-kz-api.onrender.com).
#
# Чтобы подключить приложение к серверу на своём компьютере:
# 1. скопируйте этот файл в mobile/.env;
# 2. запустите сервер из корня проекта: fastapi dev app/main.py;
# 3. перезапустите приложение: npx expo start.
#
# На телефоне в Expo Go адрес 127.0.0.1 не подойдёт: укажите адрес компьютера в Wi-Fi
# (например, http://192.168.1.5:8000) и запустите сервер командой fastapi run app/main.py.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
